N = int(input("Введите число: "))
x = list(map(int, input().split()))

max_sum = x[0]
start = 0
end = 0
current_start = 0
current_sum = x[0]

for i in range(1, N):
    if x[i] > current_sum + x[i]:
        current_sum = x[i]
        current_start = i
    else:
        current_sum += x[i]
    
    if current_sum > max_sum:
        max_sum = current_sum
        start = current_start
        end = i

print(start, end)
