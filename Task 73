N = int(input("Введите число: "))
list1 = list(map(int, input().split()))
list2 = list(map(int, input().split()))

result = -1
for shift in range(N):
    rotated = list1[-shift:] + list1[:-shift] if shift > 0 else list1[:]
    if rotated == list2:
        result = shift
        break

print(result)
