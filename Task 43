N = int(input("Введите число: "))

num1 = -1  # наибольшее число
num2 = -1  # второе по величине
if  N > 0:
    while N > 0:
        num = N % 10
        if num > num1:
            num2 = num1
            num1 = num
        elif num > num2 and num != num1:
            num2 = num
        N //= 10

    if num2 == -1:
        print("нет")
    else:
        print(num2)
else:
    print("Неверные данные")
