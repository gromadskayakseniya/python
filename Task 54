N = int(input("Введите число: "))
a = list(map(int, input().split()))

if N == 0:
    print(0)
else:
    max_len = 1
    cur_len = 1
    for i in range(1, N):
        if a[i] < a[i - 1]:
            cur_len += 1
            if cur_len > max_len:
                max_len = cur_len
        else:
            cur_len = 1
    print(max_len)
