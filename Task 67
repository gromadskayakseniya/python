N = int(input("Введите число: "))
x = list(map(int, input().split()))

found = False
for i in range(N):
    current_sum = 0
    for j in range(i, N):
        current_sum += x[j]
        if current_sum == 0 and j - i + 1 >= 2:
            found = True
            break
    if found:
        break

print("Да" if found else "Нет")
